APP_NAME=blueHubCloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_PATH=/var/www/blueHubCloud
APP_USER=www-data

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bluehub_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue configuration
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids

# Horizon naming (optional but recommended)
HORIZON_NAME=bluehubcloud
HORIZON_PATH=horizon
HORIZON_PREFIX=bluehubcloud_horizon:

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS credentials
# If AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are empty, the AWS SDK uses its
# default provider chain (instance role, shared profile, environment, etc.).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional S3 disk settings (used when FILESYSTEM_DISK=s3 or reports/settings use s3)
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# App settings asset storage
APP_SETTINGS_DISK=public
APP_SETTINGS_AWS_SECRET_NAME=app/settings-storage

# Scheduler webhook protection for /cron/pbx-sync
SCHEDULER_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Weekly reports
REPORTS_STORAGE_DISK=local
REPORTS_SIGNED_URL_MINUTES=60
WEEKLY_REPORT_TEMPLATE=reports.weekly.default
REPORTS_AI_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# AI provider key (used by AI settings seeder / features)
OPENROUTER_API_KEY=

# PBX integration
PBX_MODE=real
PBX_DEFAULT_PROVIDER=pbxware
PBXWARE_INGEST_ENABLED=true
PBXWARE_MOCK_MODE=false

# PBXware credentials flow
# Preferred: AWS Secrets Manager secret "pbxware/api-credentials"
# Fallback: environment variables below (used only when secret is missing/incomplete)
PBXWARE_API_KEY=
PBXWARE_BASE_URL=
PBXWARE_SERVER_ID=
PBXWARE_TIMEOUT=60

# PBXware / AWS secrets options
PBXWARE_AWS_REGION=ap-southeast-2
PBXWARE_DISABLE_SECRETS_CACHE=false
AWS_SECRETS_DEBUG=false


